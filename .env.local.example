# =============================================================================
# DriveLedger — Environment Variables
# =============================================================================
# 1. Copy this file:   cp .env.local.example .env.local
# 2. Fill in every value below
# 3. NEVER commit .env.local to git (it's in .gitignore)
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# New project setup:
#   1. Go to https://supabase.com → New project
#   2. Name it "driveledger" (or anything you like)
#   3. Choose a strong DB password — save it somewhere safe
#   4. Region: Africa (Cape Town) or Europe (Frankfurt) — pick closest
#   5. Wait ~2 min for the project to spin up
#   6. Go to: Project Settings → API
#   7. Copy "Project URL"    → NEXT_PUBLIC_SUPABASE_URL
#   8. Copy "anon public"    → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   9. Copy "service_role"   → SUPABASE_SERVICE_ROLE_KEY  ← keep this secret!
#
# After filling these in, run the two migration files in the Supabase SQL editor:
#   supabase/migrations/001_schema.sql
#   supabase/migrations/002_rls_policies.sql
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# PAYFAST
# Account setup:
#   1. Go to https://www.payfast.co.za → Register as merchant
#   2. Complete KYC (ID + bank account — takes 1-2 days)
#   3. Log in → Settings → Merchant Account Details
#   4. Copy "Merchant ID"    → PAYFAST_MERCHANT_ID
#   5. Copy "Merchant Key"   → PAYFAST_MERCHANT_KEY
#   6. Settings → Security → set a Passphrase → PAYFAST_PASSPHRASE
#
# For sandbox testing (no real money):
#   1. Go to https://sandbox.payfast.co.za
#   2. Register a separate sandbox merchant account
#   3. Use those credentials below
#   4. Set PAYFAST_SANDBOX=true
#
# When you go live:
#   1. Replace with your production credentials
#   2. Set PAYFAST_SANDBOX=false
# -----------------------------------------------------------------------------

PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=your_secure_passphrase
PAYFAST_SANDBOX=true


# -----------------------------------------------------------------------------
# APP URL
# Local dev:  http://localhost:3000
# Production: https://your-vercel-app.vercel.app  (or custom domain)
#
# PayFast uses this to build return/cancel/notify callback URLs.
# On Vercel, set this to your deployment URL in the environment variables UI.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
